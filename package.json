{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "data:export-overview": "node --env-file=.env scripts/export-overview-geojson.mjs",
        "data:import-open-leases": "node --env-file=.env scripts/import-open-lease-data.mjs",
        "data:import-open-leases:sqlite": "OPEN_LEASE_OUTPUT=sqlite node --env-file=.env scripts/import-open-lease-data.mjs",
        "data:sync-open-leases:mongo": "node --env-file=.env scripts/sync-open-lease-sqlite-to-mongo.mjs",
        "data:enrich-locations": "node --env-file=.env scripts/enrich-parcel-locations.mjs",
        "data:backfill-centroids": "node --env-file=.env scripts/backfill-parcel-centroids.mjs",
        "data:import-pbf-postgis": "node scripts/import-pbf-tiles-to-postgis.mjs",
        "data:assemble-postgis-parcels": "node scripts/assemble-postgis-parcels.mjs",
        "data:generate-own-pbf": "node scripts/generate-postgis-pbf-tiles.mjs",
        "data:upload-pbf-r2": "node scripts/upload-pbf-to-r2.mjs",
        "dev": "netlify dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "vite": "vite",
        "mongo:setup": "node --env-file=.env scripts/setup-mongodb.mjs",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/adm-zip": "^0.5.8",
        "@types/geojson": "^7946.0.16",
        "@vitejs/plugin-vue": "^6.0.8",
        "adm-zip": "^0.6.0",
        "geojson-vt": "^4.0.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.11",
        "vt-pbf": "^3.1.3",
        "vue-tsc": "^3.3.7"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1127.0",
        "@lucide/vue": "^1.24.0",
        "@mapbox/vector-tile": "^2.0.4",
        "maplibre-gl": "^5.24.0",
        "mongodb": "^7.5.0",
        "pbf": "^4.0.1",
        "pg": "^8.23.0",
        "vue": "^3.5.39",
        "xlsx": "^0.18.5"
    }
}
